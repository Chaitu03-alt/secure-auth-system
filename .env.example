# ==============================================================================
# secure-auth-system Environment Configuration
# Copy this file to .env and customize values for your deployment environment.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=dev_insecure_secret_key_generate_new_with_python_secrets_token_hex_32

# Database Connection (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=secure_auth_system

# Rate Limiter Storage Backend (Use memory:// for dev or redis://localhost:6379/0 for production)
RATELIMIT_STORAGE_URI=memory://

# Security & Cookie Flags
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=1800
